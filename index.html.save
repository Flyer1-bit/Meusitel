<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lukesx_ | ArmaMC Oficial</title>

<link href="https://fonts.cdnfonts.com/css/minecraft-4" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Minecraft',sans-serif;}

body{
background:#0f0f0f;
color:white;
scroll-behavior:smooth;
}

nav{
position:fixed;
top:0;
width:100%;
background:#111;
display:flex;
justify-content:center;
gap:40px;
padding:15px;
border-bottom:2px solid red;
z-index:1000;
}

nav a{
color:white;
text-decoration:none;
transition:0.2s;
}

nav a:hover{color:red;}

section{padding:120px 40px;}

.hero{
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
background:linear-gradient(180deg,#1a0000,#000);
text-align:center;
}

.hero h1{
font-size:60px;
color:red;
}

button{
background:red;
color:white;
border:none;
padding:10px 20px;
cursor:pointer;
margin-top:15px;
}

.container{
max-width:1200px;
margin:auto;
}

.card{
background:#1a1a1a;
border:2px solid red;
padding:30px;
margin-bottom:40px;
box-shadow:6px 6px 0 black;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
gap:30px;
}

.stat{
font-size:40px;
color:red;
}

#skin_container{
width:100%;
height:400px;
}

/* GALERIA */
.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.gallery img{
width:100%;
border:3px solid red;
}

/* ADMIN */
#adminPanel{
display:none;
background:#111;
padding:20px;
border:2px solid red;
margin-top:20px;
}

footer{
text-align:center;
padding:40px;
background:#111;
margin-top:50px;
}

</style>
</head>
<body>

<nav>
<a href="#home">Home</a>
<a href="#perfil">Perfil</a>
<a href="#armamc">ArmaMC</a>
<a href="#prints">Prints</a>
</nav>

<section id="home" class="hero">
<h1>👑 Lukesx_</h1>
<p>Fiel ao ArmaMC • Eden SMP</p>
<button onclick="copiarIP()">Copiar IP</button>
</section>

<section id="perfil" class="container">

<div class="grid">

<div class="card">
<h2>🧍 Skin 3D</h2>
<div id="skin_container"></div>
</div>

<div class="card">
<h2>📊 Estatísticas</h2>
<p>Horas Jogadas</p>
<div class="stat">3000+</div>
<p>Dias no ArmaMC</p>
<div class="stat" id="dias"></div>
</div>

</div>

</section>

<section id="armamc" class="container">
<div class="card">
<h2>🌐 Sobre o ArmaMC</h2>
<p><strong>IP:</strong> armamc.com</p>
<p><strong>Versões:</strong> 1.8 até 1.21</p>
<p><strong>Modos:</strong> Survival • Eden SMP</p>
<p><strong>Suporte:</strong> Java + Bedrock (19132)</p>
<p>Servidor focado em comunidade, evolução e experiência duradoura.</p>
</div>
</section>

<section id="prints" class="container">
<div class="card">
<h2>📸 Minhas Prints no ArmaMC</h2>

<div class="gallery" id="gallery"></div>

<button onclick="abrirLogin()">Painel Admin</button>

<div id="adminPanel">
<h3>Área Restrita</h3>
<input type="password" id="senha" placeholder="Senha">
<button onclick="login()">Entrar</button>
<br><br>
<input type="file" id="upload" accept="image/*">
<button onclick="adicionarPrint()">Adicionar Print</button>
</div>

</div>
</section>

<footer>
© 2026 Lukesx_ • Perfil Oficial ArmaMC
</footer>

<script src="https://unpkg.com/skinview3d/bundles/skinview3d.bundle.js"></script>
<script>
let skinViewer = new skinview3d.SkinViewer({
canvas: document.createElement("canvas"),
width: 400,
height: 400,
skin: "https://visage.surgeplay.com/skin/Lukesx_"
});
document.getElementById("skin_container").appendChild(skinViewer.canvas);
skinViewer.animation = new skinview3d.WalkingAnimation();

function copiarIP(){
navigator.clipboard.writeText("armamc.com");
alert("IP Copiado!");
}

const inicio = new Date("2025-05-27");
const hoje = new Date();
const dias = Math.floor((hoje-inicio)/(1000*60*60*24));
document.getElementById("dias").innerText = dias+" dias";

/* GALERIA */
function carregarPrints(){
let prints = JSON.parse(localStorage.getItem("prints")) || [];
let gallery = document.getElementById("gallery");
gallery.innerHTML="";
prints.forEach(img=>{
let image = document.createElement("img");
image.src=img;
gallery.appendChild(image);
});
}

function abrirLogin(){
document.getElementById("adminPanel").style.display="block";
}

function login(){
let senha = document.getElementById("senha").value;
if(senha==="123arma"){
alert("Acesso Liberado!");
}else{
alert("Senha incorreta!");
}
}

function adicionarPrint(){
let file = document.getElementById("upload").files[0];
let reader = new FileReader();
reader.onload=function(){
let prints = JSON.parse(localStorage.getItem("prints")) || [];
prints.push(reader.result);
localStorage.setItem("prints", JSON.stringify(prints));
carregarPrints();
}
if(file) reader.readAsDataURL(file);
}

carregarPrints();
</script>

</body>
</html>
